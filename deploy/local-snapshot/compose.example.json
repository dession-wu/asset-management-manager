{
  "name": "local-asset-manager",
  "networks": {
    "default": {
      "name": "asset_manager_default",
      "ipam": {}
    }
  },
  "services": {
    "app": {
      "restart": "unless-stopped",
      "command": null,
      "entrypoint": null,
      "environment": {
        "DATABASE_URL": "${DATABASE_URL}",
        "JWT_SECRET": "${JWT_SECRET}",
        "NODE_ENV": "production",
        "REFRESH_SECRET": "${REFRESH_SECRET}"
      },
      "networks": {
        "default": null
      },
      "build": {
        "context": "../..",
        "dockerfile": "Dockerfile.local"
      },
      "depends_on": {
        "db": {
          "condition": "service_healthy",
          "required": true
        }
      },
      "ports": [
        {
          "mode": "ingress",
          "target": 3000,
          "published": "8084",
          "protocol": "tcp",
          "host_ip": "127.0.0.1"
        }
      ]
    },
    "db": {
      "restart": "unless-stopped",
      "command": null,
      "entrypoint": null,
      "environment": {
        "POSTGRES_DB": "asset_manager",
        "POSTGRES_PASSWORD": "${POSTGRES_PASSWORD}",
        "POSTGRES_USER": "asset_manager"
      },
      "image": "postgres:16-alpine",
      "networks": {
        "default": null
      },
      "volumes": [
        {
          "type": "volume",
          "source": "pgdata",
          "target": "/var/lib/postgresql/data",
          "volume": {}
        },
        {
          "type": "bind",
          "source": "./runtime/init.sql",
          "target": "/docker-entrypoint-initdb.d/init.sql",
          "read_only": true,
          "bind": {}
        }
      ],
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "pg_isready -U asset_manager -d asset_manager"
        ],
        "timeout": "5s",
        "interval": "5s",
        "retries": 10
      }
    }
  },
  "volumes": {
    "pgdata": {
      "name": "asset_manager_pgdata"
    }
  }
}
